{
    "name": "the-riptide/laravel-dashboard-components",
    "description": "A set of components for the admin dashboard",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade",
        "components"
    ],
    "authors": [
        {
            "name": "Jelte ten Holt",
            "email": "jelte@theriptide.net",
            "homepage": "https://www.theriptide.net/",
            "role": "developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TheRiptide\\LaravelDashboardComponents\\ComponentServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "TheRiptide\\LaravelDashboardComponents\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
